// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  userUuid     String   @unique
  first_name   String
  last_name    String
  email        String   @unique
  password     String
  home_address String
  phone_number String
  work_address String   @default("")
  role         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isActive     Boolean
}

model products {
  productUuid  String   @unique
  storeUuid    String
  name         String
  description  String
  price        Float
  quantity     Int
  category     String
  categoryUuid String
  imageUrl     String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isActive     Boolean
  isVeg        Boolean
}

model orders {
  orderUuid    String   @unique
  userUuid     String
  productUuid  String
  quantity     Int
  total        Float
  status       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isActive     Boolean
}

model category{
  categoryUuid String @unique
  name         String
  description  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isActive     Boolean
}

model store{
  storeUuid    String   @unique
  name         String
  address      String
  phone_number String
  imageUrl     String[]
  lattitude    Float
  longitude    Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isActive     Boolean
  storeRating  Float
  storeReview  String[]
}



